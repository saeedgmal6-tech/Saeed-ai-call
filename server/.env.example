# Copy this file to .env and fill in values on the server. Never commit .env.
PORT=3000
PUBLIC_BASE_URL=https://your-public-host.example
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Gemini API key from Google AI Studio. Keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# Twilio Programmable Voice credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: public HTTPS URL to an MP3 of the exact recorded Arabic greeting.
# Leave blank and Salim will speak the configured greeting through Gemini Live.
GREETING_AUDIO_URL=

# WhatsApp Cloud API (Meta Business Platform)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_ALERT_TEMPLATE=salim_personal_alert
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Set false until keys, provider webhooks and public WSS are configured.
CALLS_ENABLED=false
